# Open Voice Agents: every setting is optional. Copy to .env and fill in what you use.

# Where the app is reachable from outside (links in texts, Twilio webhooks). Use https in public.
OVA_PUBLIC_URL=http://localhost:8080
OVA_DATA_DIR=data
# Signs links; generated into $OVA_DATA_DIR/secret when empty.
OVA_SECRET=
# Protects the console. Set it before the server is reachable by anyone else.
OVA_ADMIN_TOKEN=
# The web app's demo sign-in as an invented policyholder: on | off
OVA_DEMO_SIGNIN=on

# ---- Hearing (speech to text). Empty: browser voice in the app, Twilio on the phone.
# OVA_STT=deepgram | openai | whisper
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# OVA_WHISPER_MODEL=base.en            (local, pip install -e ".[local]")

# ---- Speaking (text to speech)
# OVA_TTS=elevenlabs | deepgram | openai | kokoro | piper | tones
ELEVENLABS_API_KEY=
# OVA_ELEVENLABS_VOICE=<voice id>
# OVA_KOKORO_MODEL=kokoro-v1.0.onnx     OVA_KOKORO_VOICES=voices-v1.0.bin
# OVA_PIPER_URL=http://piper:5000       (a Piper HTTP server beside the app)

# ---- Language model: only for what the rules cannot place, and to phrase grounded answers.
# OVA_LLM=anthropic | openai | ollama
# OVA_LLM_MODEL=<a current, fast model id from your provider>
ANTHROPIC_API_KEY=
# OVA_LLM_BASE_URL=http://localhost:11434   (Ollama or any OpenAI-compatible server)
# OVA_VISION=on                          (photo notes for the adjuster, when a model is set)

# ---- Phone and texts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# relay: Twilio hears and speaks. media: our providers do (needs hearing and speaking above).
OVA_PHONE_MODE=relay
OVA_DEFAULT_PACK=river
OVA_PHONE_PACK=river
# Where a transfer goes
OVA_CLAIMS_TRANSFER_NUMBER=
OVA_RIVER_OWNER_NUMBER=

# ---- Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- WebRTC behind strict NAT: a TURN server, as JSON RTCIceServer entries
# OVA_ICE_SERVERS=[{"urls": ["turn:turn.example.com:3478"], "username": "u", "credential": "p"}]
